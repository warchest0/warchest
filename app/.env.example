# Copy to .env.local. Leave the addresses empty to run in DEMO MODE (simulated data, clearly labeled in the UI).

# 4663 = Robinhood Chain mainnet, 46630 = testnet
NEXT_PUBLIC_CHAIN_ID=4663
# Optional RPC override (defaults to the chain's public RPC)
NEXT_PUBLIC_RPC_URL=

# Deployed contracts (DeploySystem output). Governance + vault are required to leave demo mode.
NEXT_PUBLIC_GOVERNANCE=
NEXT_PUBLIC_VAULT=
NEXT_PUBLIC_TOKEN=
NEXT_PUBLIC_DISTRIBUTOR=

# Indexer HTTP API (`npm run indexer serve`): trees, proofs and live lots. Optional; everything is re-verified on-chain.
NEXT_PUBLIC_INDEXER_API=

# Weight tree published by the indexer (defaults to $NEXT_PUBLIC_INDEXER_API/trees/{epoch}) (OZ StandardMerkleTree dump); {epoch} = UTC day index
NEXT_PUBLIC_TREE_URL_TEMPLATE=https://example.org/trees/{epoch}.json
# Cumulative distribution tree for the distributor (optional)
NEXT_PUBLIC_DISTRIBUTION_TREE_URL=

# First block to scan for events (deployment block) and max block span per eth_getLogs
NEXT_PUBLIC_START_BLOCK=0
NEXT_PUBLIC_LOG_CHUNK=50000

# 1 = force demo mode even with addresses set
NEXT_PUBLIC_DEMO=
# Serve the static export under a sub-path (e.g. /app)
NEXT_PUBLIC_BASE_PATH=
