# --- chain ---------------------------------------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# WarchestToken, its deployment block, and WarchestGovernance
TOKEN=0x...
START_BLOCK=0
GOVERNANCE=0x...
# Contracts that hold tokens but must never vote (vault, hook, distributor); PoolManager/token/governance are always excluded
EXCLUDED=0x...,0x...

# --- storage -------------------------------------------------------------------------------------------------------
DB_PATH=data/indexer.sqlite
OUT_DIR=data/trees

# --- publisher instance only (the governance `updater`) ------------------------------------------------------------
# UPDATER_PRIVATE_KEY=0x...

# --- API -----------------------------------------------------------------------------------------------------------
PORT=8787
