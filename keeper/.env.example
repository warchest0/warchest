# --- mode -----------------------------------------------------------------------------------------------------------
# dry-run (default): reads everything, logs every planned action, signs nothing.
# live: signs vault txs (KEEPER_PRIVATE_KEY) and Hyperliquid L1 actions (HL_AGENT_PRIVATE_KEY).
MODE=dry-run
# live mode on Robinhood mainnet (4663) additionally requires ALLOW_MAINNET=1
# ALLOW_MAINNET=0

# --- Robinhood Chain ------------------------------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
VAULT=0x...
GOVERNANCE=0x...
# QUOTER=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7

# --- keys (live only) -----------------------------------------------------------------------------------------------
# The vault's `keeper` EOA. Can only call convertEthToUsdg / executeDecision / reportPosition / reportClosed / reconcile.
# KEEPER_PRIVATE_KEY=0x...
# Hyperliquid AGENT (API wallet) key. Trading only. It can NEVER withdraw: the keeper refuses to sign anything but
# order / cancel / cancelByCloid / modify / batchModify / updateLeverage / updateIsolatedMargin / scheduleCancel.
# HL_AGENT_PRIVATE_KEY=0x...

# --- Hyperliquid ----------------------------------------------------------------------------------------------------
HL_NETWORK=mainnet            # mainnet | testnet
# Master account (multisig, D4) = the vault's immutable bridgeRecipient
HL_ACCOUNT=0x...
# Sub-account actually traded (D4); defaults to HL_ACCOUNT
# HL_TRADING_ACCOUNT=0x...
ALLOWED_ASSETS=BTC,ETH,SOL    # closed list; a decision outside it is refused
ENTRY_SLIPPAGE_BPS=50         # IOC price bound vs mid, entry and exit
SIZE_BUFFER_BPS=9800          # size = margin × leverage × buffer / price
TAKE_PROFIT_TRIGGER=1         # 0 = no TP trigger, governance votes the close instead
ACTION_TTL_MS=60000           # expiresAfter on every signed action
AGENT_EXPIRY_WARN_MS=259200000

# --- Across ---------------------------------------------------------------------------------------------------------
ACROSS_API_URL=https://app.across.to/api
MIN_FILL_MARGIN_SEC=1800

# --- loop / reporting / return path ---------------------------------------------------------------------------------
INTERVAL_MS=15000
DB_PATH=data/keeper.sqlite
REPORT_INTERVAL_MS=21600000   # reportPosition every 6 h
RETURN_WAIT_MS=86400000       # escalate if the multisig has not sent the funds back after 24 h
RETURN_TOLERANCE_BPS=9500     # reportClosed once ≥ 95 % of the expected return is on the vault
# FORCE_REPORT_CLOSED_ID=     # guardian-visible override for one decision id
MONITOR_KILL=0                # 1 = the independent monitor may trigger the kill switch
# ALERT_WEBHOOK_URL=https://...

# --- conversion ETH → USDG ------------------------------------------------------------------------------------------
MIN_CONVERT_WEI=100000000000000000
CONVERT_SLIPPAGE_BPS=30
